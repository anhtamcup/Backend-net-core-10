<Window x:Class="POS_App.Views.Controls.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        Width="360"
        Height="90"

        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">

    <Border CornerRadius="16"
            Background="#202225"
            Padding="18">

        <Border.Effect>
            <DropShadowEffect
                BlurRadius="20"
                ShadowDepth="2"
                Opacity="0.3"/>
        </Border.Effect>

        <Grid>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Width="42"
                    Height="42"
                    CornerRadius="21"
                    Background="#1F8B4C"
                    VerticalAlignment="Center">

                <TextBlock Text="✓"
                           Foreground="White"
                           FontSize="22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

            </Border>

            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                <TextBlock Text="Thông báo"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock x:Name="txtMessage"
                           FontSize="13"
                           Margin="0,4,0,0"
                           Foreground="#D0D0D0"
                           TextWrapping="Wrap"/>

            </StackPanel>

        </Grid>

    </Border>

</Window>